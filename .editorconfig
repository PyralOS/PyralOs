root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{rs,py}]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
